{
  "name": "dsh-accent-theme",
  "version": "0.1.0",
  "private": true,
  "description": "Custom accent colour for the DeepSeek Harness Web GUI, via the official ctx.theme.overrideTokens seam.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": ["@deepseek-ai/dsh-client-ui-theme"],
      "platform": "web"
    }
  },
  "license": "MIT"
}