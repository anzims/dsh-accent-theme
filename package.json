{
  "name": "dsh-accent-theme",
  "version": "0.2.4",
  "private": true,
  "description": "Window theme for the DeepSeek Harness Web GUI: background, input, buttons, text and accent colours, via the official ctx.theme.overrideTokens seam.",
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "theme", "colours"],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}